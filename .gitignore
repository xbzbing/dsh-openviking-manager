# lib/ is committed on purpose: `dsh plugin add github:xbzbing/dsh-openviking-manager`
# installs the committed tree without running a build. Only the Playwright browser
# fixture stays untracked, because `npm run test:e2e` rebuilds it before running.
lib/standalone.js
.env
.env.*
*.log
*.tgz
node_modules/
.DS_Store
graphify-out/
docs/local/

# Playwright browser cache (never commit downloaded browsers)
ms-playwright/
playwright-report/
test-results/
.dsh-vision-toolkit/

# Architecture diagram sources (repo keeps only the exported PNG)
docs/assets/architecture.html
docs/assets/architecture-en.html
docs/assets/architecture.json
# vision tooling artifacts (not part of the plugin)
.dsh-vision-router/
